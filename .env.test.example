# Copia este archivo como .env.test.local y completa los valores. Nunca subas .env.test.local.
# Las pruebas E2E (npm run test:e2e) usan SOLO estas 2 cuentas fijas. Nunca la service role.

# Cuenta ADMIN de prueba
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Cuenta CLIENTE de prueba: el correo DEBE terminar en @amlagrotech.test
# (solo esos pedidos se pueden anular al terminar, y el panel los oculta)
E2E_CLIENTE_EMAIL=
E2E_CLIENTE_PASSWORD=

# Fase 6A: los 2 distribuidores de demostración (migración 0014). Se crean en Supabase Auth
# con estas contraseñas ANTES de correr la 0014.
E2E_DIST1_EMAIL=distribuidor.sucre@amlagrotech.test
E2E_DIST1_PASSWORD=
E2E_DIST2_EMAIL=distribuidor.scz@amlagrotech.test
E2E_DIST2_PASSWORD=

# Fase 9C: cuentas de personal (rol almacen y repartidor, los asigna el admin)
E2E_ALMACEN_EMAIL=almacen@amlagrotech.test
E2E_ALMACEN_PASSWORD=
E2E_REPARTIDOR_EMAIL=repartidor@amlagrotech.test
E2E_REPARTIDOR_PASSWORD=
