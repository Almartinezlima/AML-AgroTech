# Copia este archivo como .env.test.local y completa los valores. Nunca subas .env.test.local.
# Las pruebas E2E (npm run test:e2e) usan SOLO estas 2 cuentas fijas. Nunca la service role.

# Cuenta ADMIN de prueba
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Cuenta CLIENTE de prueba: el correo DEBE terminar en @amlagrotech.test
# (solo esos pedidos se pueden anular al terminar, y el panel los oculta)
E2E_CLIENTE_EMAIL=
E2E_CLIENTE_PASSWORD=
