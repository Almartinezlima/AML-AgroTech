# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local.

# Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp de la tienda con código de país y sin signos. Ej.: 591XXXXXXXX
NEXT_PUBLIC_WHATSAPP_TIENDA=

# Cuenta bancaria real para pagos por transferencia (fase 9C). Si falta alguna, la tienda no
# ofrece transferencia. En Render se cargan ANTES del build (son NEXT_PUBLIC_).
NEXT_PUBLIC_BANCO_NOMBRE=
NEXT_PUBLIC_BANCO_TITULAR=
NEXT_PUBLIC_BANCO_CUENTA=
NEXT_PUBLIC_BANCO_TIPO=
