# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local.

# Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp de la tienda con código de país y sin signos. Ej.: 591XXXXXXXX
NEXT_PUBLIC_WHATSAPP_TIENDA=

# Enlace de invitación al grupo de Telegram de repartidores (fase 9F), ej.: https://t.me/+AbCdEf…
# Si falta, el panel del repartidor no muestra el botón «Unirme al grupo de Telegram».
# En Render se carga ANTES del build (es NEXT_PUBLIC_).
NEXT_PUBLIC_TELEGRAM_GRUPO_REPARTIDORES=
